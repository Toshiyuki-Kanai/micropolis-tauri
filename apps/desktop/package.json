{
  "name": "@micropolis/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "build": "vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "prebuild": "pnpm --filter micropolis exec svelte-kit sync",
