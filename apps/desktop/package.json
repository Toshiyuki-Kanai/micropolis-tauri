    "@micropolis/render-core": "workspace:*",
    "@micropolis/tile-renderer": "workspace:*",
    "@fontsource/fira-mono": "^4.5.10",
    "svelte": "^5.55.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "vite": "^5.0.3",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "vite-plugin-static-copy": "^1.0.5",
    "micropolis": "workspace:*",
    "playwright": "1.62.1"
